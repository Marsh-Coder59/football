# Application
APP_NAME=football-ai-backend
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key
ADMIN_API_KEY=change-me-admin-key

# CORS: comma-separated browser origins allowed to call this API.
# Add your deployed frontend's origin here in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/football_ai
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# A SEPARATE database the test suite is allowed to write to and truncate.
# Must never point at the same database as DATABASE_URL above.
TEST_DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/football_ai_test

# "memory" (default) uses the original in-memory repositories.
# "postgres" switches the API layer to the SQLAlchemy/PostgreSQL repositories.
# "postgres" saves to DATABASE_URL (needed for real use). "memory" forgets everything on restart.
REPOSITORY_BACKEND=postgres

# Redis (background jobs / caching - architecture ready, not required yet)
REDIS_URL=redis://localhost:6379/0

# --- Football data provider: SofaScore ---
SOFASCORE_BASE_URL=https://api.sofascore.com
SOFASCORE_API_KEY=
SOFASCORE_TIMEOUT_SECONDS=10
SOFASCORE_MAX_RETRIES=3
SOFASCORE_RATE_LIMIT_PER_MINUTE=60

# --- Odds provider: Betika ---
BETIKA_BASE_URL=
BETIKA_API_KEY=
BETIKA_TIMEOUT_SECONDS=10
BETIKA_MAX_RETRIES=3
BETIKA_RATE_LIMIT_PER_MINUTE=60

# --- Odds provider: SportPesa ---
SPORTPESA_BASE_URL=
SPORTPESA_API_KEY=
SPORTPESA_TIMEOUT_SECONDS=10
SPORTPESA_MAX_RETRIES=3
SPORTPESA_RATE_LIMIT_PER_MINUTE=60

# Model registry
MODEL_REGISTRY_DIR=./models

# --- Odds provider: The Odds API (single aggregator for all bookmakers) ---
# SAFE DEFAULTS: mock mode ON (reads saved JSON from ODDS_API_MOCK_DIR, zero credits).
# Set ODDS_API_USE_MOCK=false AND ODDS_API_KEY only when you want live calls.
ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_API_KEY=
ODDS_API_USE_MOCK=true
# Keep these narrow: cost of a call = regions x markets. Calls costing more than
# ODDS_API_MAX_COST_PER_CALL are refused before being sent.
ODDS_API_REGIONS=eu
ODDS_API_MARKETS=h2h
# Bookmakers are differentiated by query string, not by endpoint. Only betika and
# sportpesa are accepted. Check that the aggregator actually lists them for your plan.
ODDS_API_BOOKMAKERS=sportpesa,betika
ODDS_API_MAX_COST_PER_CALL=1
# Hard monthly ceiling enforced locally (persisted on disk, survives restarts).
ODDS_API_MONTHLY_CREDIT_CAP=100
ODDS_API_CACHE_TTL_SECONDS=900
ODDS_API_STATE_DIR=./.odds_api_state
ODDS_API_MOCK_DIR=./mock_data/odds_api
ODDS_API_MATCH_TOLERANCE_MINUTES=180
