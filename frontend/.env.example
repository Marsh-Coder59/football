# Base URL of the FastAPI backend. Point this at wherever
# `uvicorn app.main:app` (see backend/README.md) is actually running.
# The backend's own default port is 8000, confirmed from backend/app/core/config.py
# and backend/.env.example — not guessed.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. If set, sent as X-API-Key on the two admin-only model actions
# (validate/promote — see backend/app/core/security.py). Never required
# for anything else in this app. Leave blank in normal use; the /models
# page also lets you paste it in at runtime instead of baking it into a
# build.
NEXT_PUBLIC_ADMIN_API_KEY=
